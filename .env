# Embrix CoreUI — Automation Test Environment
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git

# ── Target environment ─────────────────────────────────────────────────
# Options: dev | qa | staging
TEST_ENV=sandbox

# ── Base URL override (optional — overrides TEST_ENV if set) ───────────
# EMBRIX_BASE_URL=https://coreui.congero.embrix.org

# ── Credentials ────────────────────────────────────────────────────────
EMBRIX_USER=congeroadmin
EMBRIX_PASSWORD=congero@123

# ── API Bearer Token ───────────────────────────────────────────────────
EMBRIX_API_BEARER_TOKEN=your_jwt_bearer_token_here

# ── Log Settings ───────────────────────────────────────────────────────
# Set to true to automatically delete old log files under test-results/logs/ before each run
CLEAN_LOGS_ON_START=false
